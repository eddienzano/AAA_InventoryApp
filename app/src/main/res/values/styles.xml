<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.YourApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorPrimaryVariant">@color/teal_200</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorSecondaryVariant">@color/purple_700</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@android:color/black</item>

        <!-- Customize status bar / nav bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>





    </style>
    <style name="HeaderCell">
        <item name="android:width">80dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">4dp</item>
    </style>


    <style name="DashboardButton"></style>

    <style name="CardStyle">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
    </style>

    <style name="GridButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>

        <!-- FIXED -->
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>
