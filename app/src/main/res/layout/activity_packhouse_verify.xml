<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#FFF5F8"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TITLE -->
        <TextView
            android:text="🏭 Packhouse Verification"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#AD1457"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- SCAN -->
        <Button
            android:id="@+id/scanBtn"
            android:text="📷 Scan Bucket"
            android:backgroundTint="#E91E63"
            android:textColor="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/qr_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Scan or paste QR..."
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888"
            android:singleLine="true"
            android:imeOptions="actionDone"/>

        <!-- STATUS -->
        <TextView
            android:id="@+id/statusText"
            android:text="Status: Waiting..."
            android:textStyle="bold"
            android:textColor="#000"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- BUCKET INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="#FFF0F4"
            android:padding="12dp">

            <TextView
                android:text="📦 Bucket Info"
                android:textStyle="bold"
                android:textColor="#AD1457"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView android:id="@+id/serial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Serial:"/>
            <TextView android:id="@+id/bucket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bucket:"/>
            <TextView android:id="@+id/farm"
                android:text="Farm:"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView android:id="@+id/length"
                android:text="Length:"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- VARIETY LIST -->
        <TextView
            android:text="Verify Varieties"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>

        <!-- SUBMIT -->
        <Button
            android:id="@+id/submitBtn"
            android:text="✅ Confirm Verification"
            android:backgroundTint="#AD1457"
            android:textColor="@android:color/white"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>