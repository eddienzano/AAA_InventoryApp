<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <ScrollView
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f8f9fa"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtUserInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User info will appear here"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_margin="8dp"/>

            <TextView
                android:text="Welcome!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_primary"
                android:layout_marginBottom="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Intake -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIntake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intake"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_scan_in"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>

            <!-- Scan Out -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                android:text="Scan Out"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_scan_out"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <!-- Back to Coldroom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanBackColdroom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan Back To Coldroom"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_coldroom"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>

            <!-- To Quarantine -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCAN TO QUARANTINE"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_sync"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>

            <!-- From Quarantine -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSFQ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCAN FROM QUARANTINE"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_sync"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>

            <!-- Stock Scan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STOCK SCAN"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_sync"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>


            <!-- Stock Scan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDampscan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCAN TO DUMP"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_sync"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>

            <!-- Wrong Scan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWrongScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correct Wrong Scan"
                app:cornerRadius="16dp"
                android:padding="16dp"
                android:backgroundTint="@color/md_theme_error"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_logout"
                app:iconPadding="8dp"
                android:layout_marginBottom="16dp"
                app:iconGravity="textStart"/>

            <!-- Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                app:cornerRadius="16dp"
                android:padding="16dp"
                android:backgroundTint="@color/md_theme_error"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_logout"
                app:iconPadding="8dp"
                app:iconGravity="textStart"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/shimmer_placeholder" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shimmer_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shimmer_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shimmer_placeholder" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Shimmer overlay -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true"
        app:shimmer_auto_start="true"
        app:shimmer_duration="1500">

    </com.facebook.shimmer.ShimmerFrameLayout>

</FrameLayout>
