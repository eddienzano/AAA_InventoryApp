<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Rejection"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="16dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Farm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/spinnerFarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"/>

            <!-- Cell Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cell Number"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/spinnerCellNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"/>

            <!-- Table Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Table Number"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/spinnerTableNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"/>


            <!-- Variety -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Variety"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2E7D32"/>
            <AutoCompleteTextView
                android:id="@+id/autoVariety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:backgroundTint="@color/teal_700"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textHint"/>

            <!-- Length -->
            <!--            <TextView-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:text="Length"-->
            <!--                android:textStyle="bold"-->
            <!--                android:textColor="#444444"-->
            <!--                android:layout_marginTop="16dp"/>-->
            <!--            <Spinner-->
            <!--                android:id="@+id/spinnerLength"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:backgroundTint="#2E7D32"/>-->

            <!-- Stems -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stems"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2E7D32"/>
            <EditText
                android:id="@+id/edtStems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:backgroundTint="@color/teal_700"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textHint"/>

            <!-- Rejection Reason -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rejection Reason"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/spinnerReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"/>

            <!-- Add to List Button -->
            <Button
                android:id="@+id/btnAddToList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Rejection"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- RecyclerView for temporary rejections -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pending Rejections"
        android:textStyle="bold"
        android:textColor="#444444"
        android:layout_marginTop="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRejections"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="4dp"/>

    <!-- Submit All + Capture Photo -->
    <Button
        android:id="@+id/btnSubmitAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit All + Capture Photo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#388E3C"
        android:layout_marginTop="16dp"/>
</LinearLayout>


