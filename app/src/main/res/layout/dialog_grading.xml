<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="20dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/txtBucket"
        android:text="Bucket Info"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Variety"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Spinner
        android:id="@+id/spinnerVariety"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        android:text="Number of Bunches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etBunches"
        android:inputType="number"
        android:hint="Enter bunches"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        android:text="Stems per Bunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etStems"
        android:inputType="number"
        android:hint="Enter stems per bunch"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

</LinearLayout>