<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quality Analysis"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="12dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/spinnerFarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Variety"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="12dp"/>
            <AutoCompleteTextView
                android:id="@+id/autoVariety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:padding="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sample space (number)"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/edtSampleSpace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:padding="12dp"
                android:hint="Enter sample space"/>

            <Button
                android:id="@+id/btnStartAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Analysis"
                android:textAllCaps="false"
                android:backgroundTint="#2E7D32"
                android:textColor="#fff"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Reason card (single reason at a time) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCurrentReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:visibility="gone"
        app:cardElevation="4dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvCurrentReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <EditText
                android:id="@+id/edtCurrentCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter count for this reason"
                android:inputType="number"
                android:padding="12dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnPrevReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnNextReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#fff"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Comments -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:visibility="gone"
        app:cardElevation="4dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <EditText
                android:id="@+id/edtComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="optional comments"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:padding="12dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSubmitAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Analysis"
        android:textAllCaps="false"
        android:backgroundTint="#388E3C"
        android:textColor="#fff"
        android:layout_marginTop="12dp"
        android:visibility="gone"/>
</LinearLayout>
