<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Select Farm"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Spinner
        android:id="@+id/spFarm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/editbox_background"/>

    <Button
        android:id="@+id/btnSync"
        android:text="Sync Buckets"
        android:textColor="#fff"
        android:backgroundTint="#2196F3"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <!-- Operations appear AFTER sync -->

    <LinearLayout
        android:id="@+id/operationsLayout"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnGraded"
            android:text="Graded Intake"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <Button
            android:id="@+id/btnScanOut"
            android:text="Scan Out Dispatch"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <Button
            android:id="@+id/btnScanOutRework"
            android:text="Scan Out Rework"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <Button
            android:id="@+id/btnSyncScanOuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync Scan Outs"/>


    </LinearLayout>

</LinearLayout>